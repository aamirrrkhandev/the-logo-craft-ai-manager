# App
AUTH_SECRET="replace-with-a-long-random-secret"
APP_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="" # Generate with: node -e "require('bcryptjs').hash('your-password',12).then(console.log)"

# PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/logo_craft_agent?schema=public"

# AI (server-side only)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# WordPress REST API - read-only account/application password recommended
WORDPRESS_URL="https://thelogocraft.com"
WORDPRESS_USERNAME=""
WORDPRESS_APP_PASSWORD=""

# Vercel - token restricted to read-only project/deployment scope
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# Optional Search Console OAuth integration is a later milestone
